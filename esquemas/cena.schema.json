{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://designer-cibernetico/esquemas/cena.schema.json",
  "title": "Documento de cena",
  "description": "Formato único lido por agentes, editor e exportador. Caixas em frações da peça.",
  "type": "object",
  "required": ["versao", "formato", "nos"],
  "properties": {
    "versao": { "const": "0.1" },
    "nome": { "type": "string" },
    "descricao": { "type": "string" },
    "formato": {
      "type": "object",
      "required": ["largura", "altura"],
      "properties": {
        "largura": { "type": "integer", "minimum": 1 },
        "altura": { "type": "integer", "minimum": 1 },
        "fundo": { "$ref": "#/definitions/cor" }
      }
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["familia", "arquivo"],
        "properties": {
          "familia": { "type": "string" },
          "peso": { "type": "integer" },
          "arquivo": { "type": "string" }
        }
      }
    },
    "nos": { "type": "array", "items": { "$ref": "#/definitions/no" } }
  },
  "definitions": {
    "cor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "caixa": {
      "type": "object",
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "origem": {
      "description": "De onde o material veio: criados, referencias ou publicos (com a licença). O banco de referências usa este campo.",
      "type": "object",
      "properties": {
        "fonte": { "enum": ["criados", "referencias", "publicos"] },
        "como": { "type": "string" },
        "licenca": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "no": {
      "type": "object",
      "required": ["id", "tipo"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tipo": { "enum": ["imagem", "gradiente", "retangulo", "bloco_texto", "grupo"] },
        "papel": { "enum": ["fundo", "texto", "mascote", "elemento", "logo", "efeito"] },
        "caixa": { "$ref": "#/definitions/caixa" },
        "encaixe": { "enum": ["conter", "cobrir", "esticar"] },
        "ancora": { "enum": ["centro", "base", "topo", "esquerda", "direita"] },
        "rotacao": { "type": "number" },
        "mascara": { "type": "string", "description": "PNG com alfa que recorta a camada de imagem (branco com alfa 0..1 = quanto aparece), esticado sobre a imagem." },
        "opacidade": { "type": "number", "minimum": 0, "maximum": 1 },
        "visivel": { "type": "boolean" },
        "bloqueado": { "type": "boolean" },
        "espelhar": { "type": "boolean" },
        "espelhar_v": { "type": "boolean" },
        "mistura": {
          "description": "Modo de mistura da camada (nomes do Photoshop em português).",
          "enum": ["normal", "multiplicar", "tela", "sobrepor", "escurecer", "clarear", "subexpor_cor", "superexpor_cor", "luz_direta", "luz_suave", "diferenca", "exclusao", "matiz", "saturacao", "cor", "luminosidade"]
        },
        "ajustes": {
          "description": "Ajustes de imagem aplicados ao nó.",
          "type": "object",
          "properties": {
            "brilho": { "type": "number", "minimum": -1, "maximum": 1 },
            "linear": { "description": "Níveis: saída = ganho * entrada + desloc (0..1). Um número vale para os três canais; uma lista [R, G, B] faz balanço de cor.", "type": "object", "properties": { "ganho": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 4 }, { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 4 }, "minItems": 3, "maxItems": 3 }] }, "desloc": { "oneOf": [{ "type": "number", "minimum": -1, "maximum": 1 }, { "type": "array", "items": { "type": "number", "minimum": -1, "maximum": 1 }, "minItems": 3, "maxItems": 3 }] } } },
            "contraste": { "type": "number", "minimum": -1, "maximum": 1 },
            "saturacao": { "type": "number", "minimum": -1, "maximum": 1 },
            "matiz": { "type": "number", "minimum": -180, "maximum": 180 },
            "tom": {
              "description": "Tinge a imagem com uma cor (mistura 'tint' com intensidade).",
              "type": "object",
              "properties": {
                "cor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                "intensidade": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": ["cor"]
            },
            "desfoque": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "efeitos": {
          "description": "Estilos de camada, em pixels do formato. Contorno só vale para texto e retângulo.",
          "type": "object",
          "properties": {
            "sombra": { "type": "object", "properties": { "cor": { "$ref": "#/definitions/cor" }, "opacidade": { "type": "number" }, "desfoque": { "type": "number" }, "dx": { "type": "number" }, "dy": { "type": "number" } } },
            "brilho": { "type": "object", "properties": { "cor": { "$ref": "#/definitions/cor" }, "opacidade": { "type": "number" }, "tamanho": { "type": "number" } } },
            "contorno": { "type": "object", "properties": { "cor": { "$ref": "#/definitions/cor" }, "largura": { "type": "number" } } },
            "relevo": { "type": "object", "properties": { "cor": { "$ref": "#/definitions/cor" }, "profundidade": { "type": "number" }, "angulo": { "type": "number" } } }
          }
        },
        "origem": { "$ref": "#/definitions/origem" },
        "asset": { "type": "string" },
        "direcao": { "enum": ["horizontal", "vertical", "radial"] },
        "paradas": {
          "type": "array",
          "items": { "type": "array", "minItems": 2, "maxItems": 3 }
        },
        "cor": { "$ref": "#/definitions/cor" },
        "fonte": {
          "type": "object", "required": ["familia"],
          "properties": { "familia": { "type": "string" }, "peso": { "type": "integer" } }
        },
        "caixa_alta": { "type": "boolean" },
        "vao": { "type": "number", "minimum": 0 },
        "espacamento": { "type": "number" },
        "alinhamento": { "enum": ["esquerda", "centro", "direita"] },
        "vertical": { "enum": ["inicio", "centro", "fim"] },
        "tamanho_max": { "type": ["number", "null"] },
        "linhas": {
          "type": "array",
          "items": {
            "type": "object", "required": ["texto"],
            "properties": {
              "texto": { "type": "string" }, "estilo": { "type": "string" }, "peso": { "type": "number", "exclusiveMinimum": 0 },
              "espacamento": { "type": "number", "description": "Espaço entre letras só desta linha (em)." },
              "trechos": {
                "description": "Pedaços da linha com estilo e tamanho próprios; o texto da linha é a soma deles.",
                "type": "array",
                "items": {
                  "type": "object", "required": ["texto"],
                  "properties": { "texto": { "type": "string" }, "estilo": { "type": "string" }, "escala": { "type": "number", "exclusiveMinimum": 0 }, "caixa_alta": { "type": "boolean" } }
                }
              }
            }
          }
        },
        "estilos": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": { "cor": { "$ref": "#/definitions/cor" }, "rampa": { "type": "array" }, "relevo": { "$ref": "#/definitions/cor" } }
          }
        },
        "sombra": { "type": "object" },
        "flex": {
          "type": "object",
          "properties": {
            "direcao": { "enum": ["linha", "coluna"] },
            "justificar": { "enum": ["inicio", "centro", "fim", "entre", "em_volta"] },
            "alinhar": { "enum": ["inicio", "centro", "fim"] },
            "espaco": { "type": "number" },
            "quebrar": { "type": "boolean" }
          }
        },
        "filhos": { "type": "array", "items": { "$ref": "#/definitions/no" } },
        "crescer": { "type": "number" }
      }
    }
  }
}
